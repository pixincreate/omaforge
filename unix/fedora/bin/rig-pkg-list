#!/bin/bash
# rig:summary=List packages in package lists
# rig:usage=rig pkg-list <type>

set -euo pipefail

RIG_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGES_DIR="$RIG_PATH/packages"

show_usage() {
    echo "Usage: rig pkg-list <type>"
    echo ""
    echo "Types:"
    echo "  base              Base packages"
    echo "  dev               Development packages"
    echo "  tools             User tools"
    echo "  system            System libraries"
    echo "  flatpak           Flatpak apps"
    echo "  rust              Rust tools"
    echo "  npm               NPM packages"
    echo "  bloatware         Bloatware to remove"
    echo ""
    echo "Examples:"
    echo "  rig pkg-list base"
    echo "  rig pkg-list rust"
}

if [[ $# -lt 1 ]]; then
    show_usage
    exit 1
fi

TYPE="$1"

case "$TYPE" in
    base) FILE="$PACKAGES_DIR/base.packages" ;;
    dev|development) FILE="$PACKAGES_DIR/development.packages" ;;
    tools) FILE="$PACKAGES_DIR/tools.packages" ;;
    system) FILE="$PACKAGES_DIR/system.packages" ;;
    flatpak) FILE="$PACKAGES_DIR/flatpak.packages" ;;
    rust) FILE="$PACKAGES_DIR/rust.packages" ;;
    npm) FILE="$PACKAGES_DIR/npm.packages" ;;
    bloatware) FILE="$PACKAGES_DIR/bloatware.packages" ;;
    *)
        echo "Error: Unknown type: $TYPE"
        show_usage
        exit 1
        ;;
esac

if [[ ! -f "$FILE" ]]; then
    echo "No $TYPE packages file found"
    exit 1
fi

echo "Packages ($TYPE):"
grep -v '^#\|^$' "$FILE" | sort || echo "(empty)"

#!/bin/bash
# rig:summary=Remove RPM packages via DNF
# rig:usage=rig pkg-remove <package> [package2 ...]

set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "Usage: rig pkg-remove <package> [package2 ...]"
    echo ""
    echo "Remove one or more RPM packages via DNF."
    echo ""
    echo "Examples:"
    echo "  rig pkg-remove neofetch"
    echo "  rig pkg-remove htop neovim firefox"
    exit 1
fi

for pkg in "$@"; do
    if rpm -q "$pkg" &>/dev/null; then
        echo "Removing: $pkg"
        sudo dnf remove -y "$pkg"
    else
        echo "Not installed: $pkg"
    fi
done

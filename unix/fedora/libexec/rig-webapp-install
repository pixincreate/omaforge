#!/bin/bash
# rig:summary=Install a web app as a desktop application
# rig:usage=rig webapp-install <name> <url> [icon-url-or-name] [custom_exec] [mime_types]

set -eu

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
DESKTOP_DIR="$HOME/.local/share/applications"
RIG_BIN="${RIG_BIN:-"$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"}"

safe_icon_name() {
  printf '%s\n' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//'
}

# The name becomes a filename. A slash would nest the launcher where
# rig-webapp-remove cannot reach it. Refuse rather than silently renaming.
require_plain_name() {
  if [[ $1 == */* ]]; then
    echo "App name cannot contain '/': $1"
    exit 1
  fi
}

icon_name_from_ref() {
  local ref="$1"
  local name
  name=$(basename "$ref")

  if [[ $name == *.* ]]; then
    safe_icon_name "${name%.*}"
  else
    printf '%s\n' "$name"
  fi
}

install_user_icon() {
  local source="$1"
  local name="$2"
  local ext="${source##*.}"

  [[ $ext == "$source" ]] && ext="png"
  mkdir -p "$ICON_DIR"
  cp "$source" "$ICON_DIR/$name.$ext"
  printf '%s\n' "$name"
}

download_icon() {
  curl -fsSL --max-time 10 -o "$2" "$1" 2>/dev/null &&
    [[ -s $2 && $(file -b --mime-type "$2") == image/* ]]
}

# Prefer the site's own high-res icon (apple-touch-icon is typically 180px+),
# then the well-known path, then Google's favicon service as a last resort.
fetch_site_icon() {
  local site_url="$1" dest="$2"
  local origin page icon_url
  origin=$(sed -E 's|^(https?://[^/]+).*|\1|' <<<"$site_url")

  page=$(curl -fsSL --max-time 5 "$site_url" 2>/dev/null | head -c 100000 | tr '\n' ' ') || true
  icon_url=$(grep -oiE "<link[^>]*rel=[\"'][^\"']*apple-touch-icon[^\"']*[\"'][^>]*>" <<<"$page" |
    grep -oiE "href=[\"'][^\"']+" | head -1 | sed -E "s/^href=[\"']//")

  case $icon_url in
  http://* | https://*) ;;
  //*) icon_url="https:$icon_url" ;;
  /*) icon_url="$origin$icon_url" ;;
  ?*) icon_url="$origin/$icon_url" ;;
  esac

  { [[ -n $icon_url ]] && download_icon "$icon_url" "$dest"; } ||
    download_icon "$origin/apple-touch-icon.png" "$dest" ||
    download_icon "https://www.google.com/s2/favicons?domain=${site_url}&sz=256" "$dest"
}

# Chromium --app= treats javascript:, file:, and data: as a document to run.
# Prefix schemeless input with https, then refuse anything that is not http(s).
normalize_webapp_url() {
  local url=$1
  if [[ ! $url =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
    url="https://$url"
  fi
  printf '%s' "$url"
}

require_http_url() {
  local url=$1

  if [[ $url =~ [[:space:]] ]]; then
    echo "Error: web app URL must not contain whitespace." >&2
    exit 1
  fi

  if [[ ! ${url,,} =~ ^https?:// ]]; then
    echo "Error: web app URL must be http or https." >&2
    exit 1
  fi
}

# Desktop Entry "string" value: a raw newline would start a new key line and
# let a value inject a second Exec=. Escape backslash first, then tab/CR/LF.
desktop_string_escape() {
  local value="$1"

  value=${value//\\/\\\\}
  value=${value//$'\t'/\\t}
  value=${value//$'\r'/\\r}
  value=${value//$'\n'/\\n}

  printf '%s' "$value"
}

# One Exec argument, double-quoted per the freedesktop Exec spec: inside
# quotes " ` $ \ take a backslash and a literal % becomes %%.
desktop_exec_arg() {
  local escaped
  # shellcheck disable=SC2016 # single quotes are intentional: sed must see literal escapes
  escaped=$(printf '%s' "$1" |
    sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/`/\\`/g' -e 's/\$/\\$/g' -e 's/%/%%/g')
  printf '"%s"' "$escaped"
}

if (( $# < 2 )); then
  echo "Usage: rig-webapp-install <name> <url> [icon-url-or-name] [custom_exec] [mime_types]"
  exit 1
fi

APP_NAME="$1"
APP_URL=$(normalize_webapp_url "$2")
ICON_REF="${3:-}"
CUSTOM_EXEC="${4:-}"
MIME_TYPES="${5:-}"

require_http_url "$APP_URL"
require_plain_name "$APP_NAME"

if [[ -z $APP_NAME || -z $APP_URL ]]; then
  echo "Error: You must set app name and app URL!"
  exit 1
fi

# Resolve the icon: explicit URL, local file, theme name, or auto-fetch
# from the site when no icon reference is given.
mkdir -p "$ICON_DIR"
ICON_VALUE=$(safe_icon_name "$APP_NAME")
if [[ -z $ICON_REF ]]; then
  if ! fetch_site_icon "$APP_URL" "$ICON_DIR/$ICON_VALUE.png"; then
    echo "Error: Failed to download icon for $APP_NAME. Pass an icon URL as the third argument."
    exit 1
  fi
elif [[ $ICON_REF =~ ^https?:// ]]; then
  if ! download_icon "$ICON_REF" "$ICON_DIR/$ICON_VALUE.png"; then
    echo "Error: Failed to download icon from $ICON_REF"
    exit 1
  fi
elif [[ -f $ICON_REF ]]; then
  install_user_icon "$ICON_REF" "$ICON_VALUE" >/dev/null
else
  # Theme icon name bundled by the system icon theme ("HEY" or "HEY.png")
  ICON_VALUE=$(icon_name_from_ref "$ICON_REF")
fi
gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true

# Default Exec quotes the URL as one Exec-spec argument; the whole line then
# gets file-syntax escaping. $CUSTOM_EXEC is a full command line, so it gets
# file-syntax escaping only.
if [[ -n $CUSTOM_EXEC ]]; then
  EXEC_COMMAND=$CUSTOM_EXEC
else
  EXEC_COMMAND="$RIG_BIN/rig-launch-webapp $(desktop_exec_arg "$APP_URL")"
fi

DESKTOP_FILE="$DESKTOP_DIR/$APP_NAME.desktop"
mkdir -p "$DESKTOP_DIR"

name_field=$(desktop_string_escape "$APP_NAME")
exec_field=$(desktop_string_escape "$EXEC_COMMAND")
icon_field=$(desktop_string_escape "$ICON_VALUE")

cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=$name_field
Comment=$name_field Web Application
Exec=$exec_field
Terminal=false
Type=Application
Icon=$icon_field
StartupNotify=true
Categories=Network;WebBrowser;
EOF

if [[ -n $MIME_TYPES ]]; then
  printf 'MimeType=%s\n' "$(desktop_string_escape "$MIME_TYPES")" >>"$DESKTOP_FILE"
fi

chmod +x "$DESKTOP_FILE"

echo "✓ Installed $APP_NAME"
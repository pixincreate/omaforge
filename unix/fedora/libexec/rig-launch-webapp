#!/bin/bash
# rig:summary=Launch a web app URL in the default browser
# rig:usage=rig launch-webapp <url> [args]

browser=$(xdg-settings get default-web-browser 2>/dev/null)

# Flags per browser family; webapps open in private/incognito windows.
# Flags and URL must be separate args: browsers ignore concatenated flag strings.
case ${browser%.desktop} in
    *chrome*|*brave*|*edge*|*opera*|*vivaldi*|*chromium*)
        flags=(--incognito --app="$1")
        ;;
    *helium*)
        # Helium renders --app= windows blank grey; use a plain incognito window.
        flags=(--incognito)
        ;;
    *firefox*|*zen*|*floorp*|*librewolf*)
        flags=(--private-window)
        ;;
    *)
        # Fallback to Brave Flatpak
        exec setsid flatpak run com.brave.Browser --incognito --app="$1" "${@:2}"
        ;;
esac

# Locate the browser desktop file across XDG and Flatpak data dirs.
desktop_file=""
for dir in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
    "$HOME/.local/share/flatpak/exports/share/applications" \
    /usr/local/share/applications \
    /usr/share/applications \
    /var/lib/flatpak/exports/share/applications; do
    if [[ -f $dir/$browser ]]; then
        desktop_file="$dir/$browser"
        break
    fi
done

# Unknown browser: fall back to Brave Flatpak
if [[ -z $desktop_file ]]; then
    exec setsid flatpak run com.brave.Browser --incognito --app="$1" "${@:2}"
fi

if grep -q '^Exec=.*flatpak run' "$desktop_file"; then
    # Flatpak browsers: desktop ID minus .desktop suffix is the app ID
    exec setsid flatpak run "${browser%.desktop}" "${flags[@]}" "$1" "${@:2}"
fi

# Regular package: extract binary path from Exec
browser_bin=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$desktop_file" | head -1)
exec setsid "$browser_bin" "${flags[@]}" "$1" "${@:2}"

#!/bin/bash
# rig:summary=Unified command dispatcher for rig tools
# rig:usage=rig <command> [args]

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RIG_PATH="$(cd "$BIN_DIR/../../.." && pwd)"
export RIG_PATH
export RIG_PLATFORM="macos"

LIB_DIR="$BIN_DIR/../libexec"
[[ -d "$LIB_DIR" ]] || LIB_DIR="$BIN_DIR"
export RIG_BIN="$LIB_DIR"

COMMON_LIB_DIR="$RIG_PATH/unix/common/libexec"
[[ -d "$COMMON_LIB_DIR" ]] || COMMON_LIB_DIR=""

show_help() {
  echo "Usage: rig <command> [args]"
  echo ""
  echo "Available commands:"
  echo ""

  for dir in "$LIB_DIR" "$COMMON_LIB_DIR"; do
    [[ -d "$dir" ]] || continue
    for script in "$dir"/rig-*; do
      [[ -x "$script" ]] || continue
      cmd_name=$(basename "$script" | sed 's/^rig-//')
      summary=$(grep -m1 '^# rig:summary=' "$script" 2>/dev/null | sed 's/^# rig:summary=//')
      printf "  %-20s %s\n" "$cmd_name" "${summary:-(no description)}"
    done
  done | sort -uk1,1

  echo ""
  echo "For detailed help on a command, run: rig <command> --help"
}

if [[ $# -eq 0 ]]; then
  show_help
  exit 0
fi

case "$1" in
  -h|--help)
    show_help
    exit 0
    ;;
esac

# Multi-word prefix routing (inspired by omarchy)
# Try each prefix from all-words down to 1 word
args=("$@")
for (( i = ${#args[@]}; i >= 1; i-- )); do
  cmd=$(printf "%s-" "${args[@]:0:i}" | sed 's/-$//')

  # Check platform libexec first (takes priority)
  bin="$LIB_DIR/rig-$cmd"
  if [[ -x "$bin" ]]; then
    exec "$bin" "${args[@]:i}"
  fi

  # Fall back to common libexec
  if [[ -n "$COMMON_LIB_DIR" ]]; then
    common_bin="$COMMON_LIB_DIR/rig-$cmd"
    if [[ -x "$common_bin" ]]; then
      exec "$common_bin" "${args[@]:i}"
    fi
  fi
done

echo "Error: unknown command '${args[0]}'"
echo "Run 'rig' without arguments to see available commands."
exit 1

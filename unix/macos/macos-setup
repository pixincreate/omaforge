#!/bin/bash
# macOS Declarative Setup System
# Main entry point

set -eEo pipefail

# Error handler
error_handler() {
    local line_no=$1
    local cmd="$BASH_COMMAND"
    local script="${CURRENT_SCRIPT:-$0}"
    local script_name
    script_name=$(basename "$script")

    echo ""
    echo -e "\033[0;31m=========================================\033[0m"
    echo -e "\033[0;31m[ERROR] Setup failed\033[0m"
    echo -e "\033[0;33m[ERROR] Script: $script_name\033[0m"
    echo -e "\033[0;33m[ERROR] Line: $line_no\033[0m"
    echo -e "\033[0;33m[ERROR] Command: $cmd\033[0m"
    echo -e "\033[0;31m=========================================\033[0m"
    echo ""
    echo -e "\033[0;36mCheck the log file for details:\033[0m"
    echo -e "\033[0;36m  cat ~/.local/state/rig/install.log\033[0m"
    echo ""
    exit 1
}

trap 'error_handler $LINENO' ERR

# Parse command-line arguments
ONLY_MODULE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --only)
            ONLY_MODULE="$2"
            shift 2
            ;;
        --help|-h)
            echo "Usage: $0 [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --only <module>    Run only a specific module"
            echo "                     Examples: config/git, dotfiles/stow, packaging/brew"
            echo "  --help, -h        Show this help message"
            echo ""
            echo "Examples:"
            echo "  $0                          # Run full setup"
            echo "  $0 --only config/git        # Run only git configuration"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Define paths with RIG prefix for consistency
RIG_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export RIG_PATH
export RIG_INSTALL="$RIG_PATH/install"
export RIG_CONFIG="$RIG_PATH/config.json"
export PATH="$RIG_PATH/bin:$PATH"

# Ensure jq is available for JSON parsing
if ! command -v jq &>/dev/null; then
    echo "[INFO] jq is required for configuration parsing"
    echo "[INFO] Installing jq via Homebrew..."

    # Install Homebrew if needed
    if ! command -v brew &>/dev/null; then
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

        # Add to PATH
        if [[ -f /opt/homebrew/bin/brew ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [[ -f /usr/local/bin/brew ]]; then
            eval "$(/usr/local/bin/brew shellenv)"
        fi
    fi

    brew install jq
    echo "[SUCCESS] jq installed"
fi

# Source all helper functions
source "$RIG_INSTALL/helpers/all.sh"

# Function to run a single module
run_single_module() {
    local module="$1"

    # Normalize: add .sh if not present
    [[ "$module" != *.sh ]] && module="$module.sh"

    local module_path

    if [[ "$module" == */* ]]; then
        # Path format: config/git.sh - match full path under install/
        # This handles cases like config/git, dotfiles/stow, etc.
        module_path=$(find "$RIG_INSTALL" -path "*/$module" -type f)
    else
        # Name format: git.sh - find all matches and fail if ambiguous
        # This prevents silent mis-selection when multiple modules share the same filename
        local candidates
        candidates=$(find "$RIG_INSTALL" -name "$module" -type f)
        local count
        count=$(echo "$candidates" | wc -l | xargs)
        # count=0 means no matches, count=1 means exactly one, count>1 means ambiguous

        if [[ $count -eq 0 ]]; then
            echo "[ERROR] Module not found: $module"
            exit 1
        elif [[ $count -gt 1 ]]; then
            echo "[ERROR] Ambiguous module name: $module"
            echo "Found $count matches:"
            echo "$candidates" | while read -r path; do
                [[ -n "$path" ]] && echo "  - $path"
            done
            echo ""
            echo "Specify the full path to disambiguate (e.g., config/git or dotfiles/zsh)"
            exit 1
        fi

        module_path="$candidates"
    fi

    if [[ -z "$module_path" ]]; then
        echo "[ERROR] Module not found: $module"
        exit 1
    fi

    echo "[INFO] Running: $module_path"
    run_logged "$module_path"
    echo "[SUCCESS] Completed"
}

# Presentation helpers
show_logo() {
    clear
    cat << 'EOF'
██████  ██  ██████
██   ██ ██ ██
██████  ██ ██   ███
██   ██ ██ ██    ██
██   ██ ██  ██████
EOF
    echo ""
}

show_welcome() {
    show_logo
    echo "Declarative macOS Setup System"
    echo ""
    echo "This will configure your macOS system with:"
    echo "  - Homebrew package management"
    echo "  - Development tools and applications"
    echo "  - System configuration and optimizations"
    echo "  - Dotfiles and configurations"
    echo ""
}

# Check if running single module or full setup
if [[ -n "$ONLY_MODULE" ]]; then
    run_single_module "$ONLY_MODULE"
else
    # Show welcome message
    show_welcome

    # Execute installation phases
    run_logged "$RIG_INSTALL/preflight/all.sh"
    run_logged "$RIG_INSTALL/packaging/all.sh"
    run_logged "$RIG_INSTALL/config/all.sh"
    run_logged "$RIG_INSTALL/dotfiles/all.sh"
    run_logged "$RIG_INSTALL/external/all.sh"
    run_logged "$RIG_INSTALL/post-install/all.sh"
fi

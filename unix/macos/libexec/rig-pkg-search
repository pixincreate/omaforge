#!/bin/bash
# rig:summary=Search Homebrew and Cask repositories
# rig:usage=rig pkg-search <term> [--cask]

set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "Usage: rig pkg-search <term> [--cask]"
    echo ""
    echo "Search Homebrew (or Cask) for packages."
    echo ""
    echo "Examples:"
    echo "  rig pkg-search neovim          # Search Homebrew"
    echo "  rig pkg-search firefox --cask  # Search Cask"
    exit 1
fi

TERM=""
MODE="brew"

for arg in "$@"; do
    case "$arg" in
        --cask) MODE="cask" ;;
        -*) echo "Unknown option: $arg"; exit 1 ;;
        *) TERM="$arg" ;;
    esac
done

if [[ -z "$TERM" ]]; then
    echo "Error: search term required"
    exit 1
fi

if ! command -v brew &>/dev/null; then
    echo "Error: Homebrew is not installed"
    echo "Run ./macos-setup first"
    exit 1
fi

case "$MODE" in
    brew)
        echo "Searching Homebrew for: $TERM"
        brew search "$TERM"
        ;;
    cask)
        echo "Searching Homebrew Cask for: $TERM"
        brew search --cask "$TERM"
        ;;
esac

#!/bin/bash
# rig:summary=Add a package to package lists
# rig:usage=rig pkg-add <type> <name>

set -euo pipefail

RIG_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGES_DIR="$RIG_PATH/packages"

show_usage() {
    echo "Usage: rig pkg-add <type> <package-name>"
    echo ""
    echo "Types:"
    echo "  brew              CLI tools (brew.packages)"
    echo "  cask              GUI applications (cask.packages)"
    echo "  rust              Rust tools (rust.packages)"
    echo ""
    echo "Examples:"
    echo "  rig pkg-add brew neovim"
    echo "  rig pkg-add cask firefox"
}

if [[ $# -lt 2 ]]; then
    show_usage
    exit 1
fi

TYPE="$1"
NAME="$2"

case "$TYPE" in
    brew) FILE="$PACKAGES_DIR/brew.packages" ;;
    cask) FILE="$PACKAGES_DIR/cask.packages" ;;
    rust) FILE="$PACKAGES_DIR/rust.packages" ;;
    *)
        echo "Error: Unknown type: $TYPE"
        show_usage
        exit 1
        ;;
esac

if grep -qx "$NAME" "$FILE" 2>/dev/null; then
    echo "Package '$NAME' already exists in $TYPE"
    exit 0
fi

echo "$NAME" >> "$FILE"
echo "✓ Added '$NAME' to $TYPE packages"
echo ""
echo "To install, run: ./macos-setup --only packaging/$TYPE"

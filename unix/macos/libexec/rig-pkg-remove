#!/bin/bash
# rig:summary=Remove a package from package lists
# rig:usage=rig pkg-remove <type> <name>

set -euo pipefail

RIG_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGES_DIR="$RIG_PATH/packages"

show_usage() {
    echo "Usage: rig pkg-remove <type> <package-name>"
    echo ""
    echo "Types:"
    echo "  brew              CLI tools (brew.packages)"
    echo "  cask              GUI applications (cask.packages)"
    echo "  rust              Rust tools (rust.packages)"
    echo ""
    echo "Examples:"
    echo "  rig pkg-remove brew neovim"
    echo "  rig pkg-remove cask firefox"
}

if [[ $# -lt 2 ]]; then
    show_usage
    exit 1
fi

TYPE="$1"
NAME="$2"

case "$TYPE" in
    brew) FILE="$PACKAGES_DIR/brew.packages" ;;
    cask) FILE="$PACKAGES_DIR/cask.packages" ;;
    rust) FILE="$PACKAGES_DIR/rust.packages" ;;
    *)
        echo "Error: Unknown type: $TYPE"
        show_usage
        exit 1
        ;;
esac

if grep -qx "$NAME" "$FILE" 2>/dev/null; then
    sed -i '' "/^$NAME$/d" "$FILE"
    echo "✓ Removed '$NAME' from $TYPE packages"
else
    echo "Package '$NAME' not found in $TYPE packages"
    exit 1
fi

#!/bin/bash
# rig:summary=Reset dotfiles, config, and packages
# rig:usage=rig reset <subcommand> [options]

set -euo pipefail

RIG_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RIG_INSTALL="$RIG_PATH/install"
export RIG_CONFIG="$RIG_PATH/config.json"

source "$RIG_INSTALL/helpers/all.sh"

show_usage() {
    echo "Usage: rig reset <subcommand> [options]"
    echo ""
    echo "Subcommands:"
    echo "  zsh              Reset ZSH configuration"
    echo "  stow             Re-stow dotfiles"
    echo "  fonts            Reinstall fonts"
    echo "  directories      Recreate directories"
    echo "  git              Reset Git & SSH configuration"
    echo "  nextdns          Reset NextDNS"
    echo "  rust             Reinstall Rust tools"
    echo ""
    echo "Options:"
    echo "  -h, --help       Show this help"
}

reset_zsh() {
    log_info "Resetting ZSH configuration..."

    read -p "This will reset your ZSH config. Continue? [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Cancelled."
        return
    fi

    rm -rf ~/.zsh/.zgenom ~/.zsh/.additionals.zsh
    run_logged "$RIG_INSTALL/dotfiles/zsh.sh"
    log_success "ZSH reset complete"
    log_info "Run 'exec zsh' to reload"
}

reset_stow() {
    log_info "Resetting dotfiles..."

    read -p "This will re-stow all dotfiles. Continue? [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Cancelled."
        return
    fi

    run_logged "$RIG_INSTALL/dotfiles/stow.sh"
    log_success "Dotfiles reset complete"
}

reset_fonts() {
    log_info "Reinstalling fonts..."
    run_logged "$RIG_INSTALL/dotfiles/fonts.sh"
    log_success "Fonts reinstalled"
}

reset_directories() {
    log_info "Recreating directories..."
    run_logged "$RIG_INSTALL/dotfiles/directories.sh"
    log_success "Directories created"
}

reset_git() {
    log_info "Resetting Git & SSH configuration..."

    read -p "This will reconfigure Git and SSH. Continue? [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Cancelled."
        return
    fi

    run_logged "$RIG_INSTALL/config/git.sh"
    log_success "Git & SSH reset complete"
}

reset_nextdns() {
    log_info "Resetting NextDNS..."
    run_logged "$RIG_INSTALL/config/nextdns.sh"
    log_success "NextDNS reset complete"
}

reset_rust() {
    log_info "Reinstalling Rust tools..."

    read -p "This will reinstall Rust tools. Continue? [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Cancelled."
        return
    fi

    run_logged "$RIG_INSTALL/packaging/rust.sh"
    log_success "Rust tools reinstalled"
}

case "${1:-}" in
    ""|-h|--help)
        show_usage
        ;;
    zsh)
        reset_zsh
        ;;
    stow)
        reset_stow
        ;;
    fonts)
        reset_fonts
        ;;
    directories)
        reset_directories
        ;;
    git)
        reset_git
        ;;
    nextdns)
        reset_nextdns
        ;;
    rust)
        reset_rust
        ;;
    *)
        echo "Unknown subcommand: $1"
        echo "Run 'rig reset' for usage."
        exit 1
        ;;
esac

#!/usr/bin/python3
# rig:summary=OpenAI-compatible proxy injecting a base system prompt ahead of every request
# rig:usage=rig llama-proxy --listen PORT --upstream HOST:PORT --prompt-file FILE [--self-test]

import argparse
import json
import sys
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

BASE_PROMPT = ""
UPSTREAM = ""
CHAT_PATH = "/v1/chat/completions"


def inject(messages):
  out = list(messages)
  if out and isinstance(out[0], dict) and out[0].get("role") == "system":
    old = out[0].get("content") or ""
    out[0] = dict(out[0])
    out[0]["content"] = BASE_PROMPT + "\n\n" + old if old else BASE_PROMPT
  else:
    out.insert(0, {"role": "system", "content": BASE_PROMPT})
  return out


class ProxyHandler(BaseHTTPRequestHandler):
  protocol_version = "HTTP/1.1"

  def do_GET(self):
    self._relay()

  def do_POST(self):
    self._relay()

  def _rewrite_body(self, raw):
    if self.command != "POST" or not self.path.startswith(CHAT_PATH) or not raw:
      return raw
    try:
      payload = json.loads(raw)
    except ValueError:
      return raw
    if isinstance(payload, dict) and isinstance(payload.get("messages"), list):
      payload["messages"] = inject(payload["messages"])
      return json.dumps(payload).encode()
    return raw

  def _send_json(self, code, obj):
    data = json.dumps(obj).encode()
    self.send_response(code)
    self.send_header("Content-Type", "application/json")
    self.send_header("Content-Length", str(len(data)))
    self.end_headers()
    self.wfile.write(data)

  def _relay(self):
    length = int(self.headers.get("Content-Length") or 0)
    raw = self.rfile.read(length) if length else None
    body = self._rewrite_body(raw)

    req = urllib.request.Request(UPSTREAM + self.path, data=body, method=self.command)
    for key, val in self.headers.items():
      if key.lower() in ("host", "content-length", "connection", "accept-encoding"):
        continue
      req.add_header(key, val)

    try:
      up = urllib.request.urlopen(req, timeout=600)
    except urllib.error.HTTPError as err:
      up = err
    except urllib.error.URLError:
      self._send_json(502, {"error": {"message": "upstream " + UPSTREAM + " unreachable"}})
      return

    try:
      self.send_response(up.code)
      chunked = "chunked" in (up.headers.get("Transfer-Encoding") or "").lower()
      clen = up.headers.get("Content-Length")
      for key, val in up.headers.items():
        if key.lower() in ("transfer-encoding", "connection", "content-length"):
          continue
        self.send_header(key, val)
      if clen is not None and not chunked:
        self.send_header("Content-Length", clen)
        self.end_headers()
        self.wfile.write(up.read())
      else:
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        while True:
          chunk = up.read(8192)
          if not chunk:
            break
          self.wfile.write(chunk)
          self.wfile.flush()
    finally:
      up.close()

  def log_message(self, format, *args):
    pass


def self_test():
  global BASE_PROMPT
  BASE_PROMPT = "BASE"
  cases = [
    ([{"role": "user", "content": "hi"}],
     [{"role": "system", "content": "BASE"}, {"role": "user", "content": "hi"}]),
    ([{"role": "system", "content": "H"}, {"role": "user", "content": "x"}],
     [{"role": "system", "content": "BASE\n\nH"}, {"role": "user", "content": "x"}]),
    ([],
     [{"role": "system", "content": "BASE"}]),
  ]
  for given, want in cases:
    snapshot = json.dumps(given)
    got = inject(given)
    assert got == want, f"inject({given}) -> {got}, want {want}"
    assert json.dumps(given) == snapshot, "input mutated"
  print("self-test: PASS")


def main():
  global BASE_PROMPT, UPSTREAM
  parser = argparse.ArgumentParser()
  parser.add_argument("--listen", type=int, default=8080)
  parser.add_argument("--upstream", default="127.0.0.1:8081")
  parser.add_argument("--prompt-file")
  parser.add_argument("--self-test", action="store_true")
  args = parser.parse_args()

  if args.self_test:
    self_test()
    return 0

  if not args.prompt_file:
    parser.error("--prompt-file is required")
  with open(args.prompt_file, encoding="utf-8") as fh:
    BASE_PROMPT = fh.read().strip()
  if not BASE_PROMPT:
    print("rig-llama-proxy: empty prompt file", file=sys.stderr)
    return 1
  UPSTREAM = "http://" + args.upstream

  server = ThreadingHTTPServer(("127.0.0.1", args.listen), ProxyHandler)
  server.daemon_threads = True
  print(f"rig-llama-proxy: listening on 127.0.0.1:{args.listen} -> {args.upstream}", flush=True)
  server.serve_forever()
  return 0


if __name__ == "__main__":
  sys.exit(main())

#!/bin/bash
# rig:summary=Download and install fonts from GitHub releases
# rig:usage=rig fonts install [--force]

set -euo pipefail

RIG_PATH="${RIG_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)}"
FONTS_SCRIPT="$RIG_PATH/unix/common/dotfiles/fonts.sh"

show_usage() {
    echo "Usage: rig fonts <subcommand> [options]"
    echo ""
    echo "Subcommands:"
    echo "  install          Download and install fonts from GitHub releases"
    echo ""
    echo "Options:"
    echo "  --force          Force re-download even if fonts are installed"
    echo ""
    echo "Fonts installed:"
    # shellcheck source=../../common/dotfiles/fonts.sh
    source "$FONTS_SCRIPT"
    local font_def name filter
    for font_def in "${FONTS[@]}"; do
        name="${font_def%%|*}"
        filter="${font_def##*|}"
        echo "  - ${name}${filter:+ ($filter)}"
    done
    echo ""
    echo "Examples:"
    echo "  rig fonts install"
    echo "  rig fonts install --force"
}

install_fonts_cmd() {
    local force_flag=""

    # Parse --force from remaining args
    for arg in "$@"; do
        if [[ "$arg" == "--force" ]]; then
            force_flag="--force"
        fi
    done

    if [[ ! -f "$FONTS_SCRIPT" ]]; then
        echo "Error: fonts script not found at $FONTS_SCRIPT"
        exit 1
    fi

    # shellcheck source=../../common/dotfiles/fonts.sh
    source "$FONTS_SCRIPT"

    echo "Downloading and installing fonts from GitHub releases..."

    local fonts_source
    fonts_source=$(download_github_fonts $force_flag)
    local download_status=$?

    # If fonts already installed (empty return), exit successfully
    if [[ -z "$fonts_source" && $download_status -eq 0 ]]; then
        echo "Fonts already installed at $HOME/.local/share/fonts"
        echo "Use --force to re-download."
        return 0
    fi

    if [[ $download_status -ne 0 ]]; then
        echo "Error: Failed to download fonts"
        return 1
    fi

    local temp_dir
    temp_dir=$(dirname "$fonts_source")

    install_fonts "$fonts_source"
    local install_status=$?

    rm -rf "$temp_dir"

    if [[ $install_status -eq 0 ]]; then
        echo ""
        echo "Fonts installed successfully!"
    fi

    return $install_status
}

case "${1:-}" in
    ""|-h|--help)
        show_usage
        ;;
    install)
        shift
        install_fonts_cmd "$@"
        ;;
    *)
        echo "Unknown subcommand: $1"
        echo "Run 'rig fonts' for usage."
        exit 1
        ;;
esac

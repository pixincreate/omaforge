#!/bin/bash
# rig:summary=Capture a screen region and copy extracted text to the clipboard
# rig:usage=rig ocr

set -euo pipefail

# Private temp dir: predictable /tmp paths are a symlink-clobbering hazard
tmpd="$(mktemp -d)"
snapshot="$tmpd/capture.png"

cleanup() {
  rm -rf "$tmpd"
}
trap cleanup EXIT

# Runtime detection instead of platform detection: works wherever the tools exist.
if command -v screencapture &>/dev/null; then
  capture() {
    screencapture -i "$snapshot"
  }
elif command -v spectacle &>/dev/null; then
  capture() {
    spectacle --background --region --nonotify --output "$snapshot"
  }
else
  echo "[ERROR] Need screencapture (macOS) or spectacle (KDE)"
  exit 1
fi

clipboard() {
  # pbcopy preferred; wl-copy is the Wayland fallback, xclip the X11 one
  if command -v pbcopy &>/dev/null; then
    printf "%s" "$text" | pbcopy
  elif command -v wl-copy &>/dev/null; then
    printf "%s" "$text" | wl-copy
  else
    printf "%s" "$text" | xclip -selection clipboard
  fi
}

if ! command -v tesseract &>/dev/null; then
  echo "[ERROR] tesseract is not installed"
  exit 1
fi

echo "Select a region to extract text..."
capture

if [[ ! -f "$snapshot" ]]; then
  echo "[ERROR] No region captured"
  exit 1
fi

text=""
if tesseract --list-langs 2>/dev/null | grep --quiet "^kan$"; then
  text=$(tesseract "$snapshot" stdout --lang kan+eng 2>/dev/null || true)
elif tesseract --list-langs 2>/dev/null | grep --quiet "^hin$"; then
  text=$(tesseract "$snapshot" stdout --lang hin+eng 2>/dev/null || true)
fi

if [[ -z "$text" ]]; then
  text=$(tesseract "$snapshot" stdout 2>/dev/null || true)
fi

if [[ -z "$text" ]]; then
  echo "[WARNING] No text detected"
  exit 0
fi

clipboard

echo "[SUCCESS] Extracted text copied to clipboard"
